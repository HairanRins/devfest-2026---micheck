[TEMPLATE]
# Ordre de préférence des fournisseurs IA ; tout fournisseur doté d'une clé est essayé ensuite.
CONTEXT_DETECTOR_AI_PROVIDERS=groq,xai,mistral,gemini,huggingface
# Modèle principal Groq (quota gratuit ~12k tokens/min) et repli si le quota est trop bas.
CONTEXT_DETECTOR_GROQ_MODEL=llama-3.3-70b-versatile
CONTEXT_DETECTOR_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
# Tokens de sortie maximum par requête ; ils comptent dans le quota tokens/minute du fournisseur.
CONTEXT_DETECTOR_AI_MAX_TOKENS=4096
# Modèles multimodaux utilisés pour les images envoyées en dataUrl et les images clés vidéo.
CONTEXT_DETECTOR_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CONTEXT_DETECTOR_MISTRAL_VISION_MODEL=pixtral-12b-2409
CONTEXT_DETECTOR_GEMINI_VISION_MODEL=gemini-2.5-flash
# Tokens de sortie du bot de discussion (/api/context-detector/chat).
CONTEXT_DETECTOR_CHAT_MAX_TOKENS=1024
CONTEXT_DETECTOR_GROQ_API_KEY=
CONTEXT_DETECTOR_XAI_API_KEY=
CONTEXT_DETECTOR_MISTRAL_API_KEY=
CONTEXT_DETECTOR_GEMINI_API_KEY=
CONTEXT_DETECTOR_HF_API_KEY=

# Ordre de préférence des moteurs de recherche ; tout moteur doté d'une clé est essayé ensuite.
CONTEXT_DETECTOR_SEARCH_PROVIDERS=tavily,brave
CONTEXT_DETECTOR_TAVILY_API_KEY=
CONTEXT_DETECTOR_BRAVE_API_KEY=

# Local fallback (off by default) — see docs/adr-local-fallback.md
# Used only when every remote AI provider failed. Results are marked "indicative".
# Setup: npm run models:install && npm run models:download (~2 GB)
CONTEXT_DETECTOR_LOCAL_FALLBACK=off
CONTEXT_DETECTOR_LOCAL_MODEL_PATH=local-models/qwen2.5-3b-instruct-q4_k_m.gguf
CONTEXT_DETECTOR_LOCAL_TIMEOUT_MS=300000
# Folder where the OCR language data is copied from node_modules on first use
CONTEXT_DETECTOR_OCR_LANG_DIR=local-models/tesseract
